# ---- Required ----
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/smis?sslmode=require"
# Public URL of the app (used in links in emails and for CSRF origin checks)
APP_URL="https://smis.bishopogez.com"
# 32+ random bytes, e.g. `openssl rand -base64 48`
SESSION_SECRET="change-me"

# ---- File storage ----
# "local" (development only: writes to ./storage) or "s3" (any S3-compatible store: AWS S3, Cloudflare R2, Backblaze B2)
STORAGE_DRIVER="local"
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# ---- Email (password resets, notices) ----
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Bishop Ogez High School <ogezhigh@gmail.com>"

# ---- SMS (Africa's Talking) ----
AT_USERNAME=""
AT_API_KEY=""
AT_SENDER_ID=""

# ---- WhatsApp Business (Meta Cloud API) ----
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
