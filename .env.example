# ---- Required ----
# App connections (on Vercel: the provider's TRANSACTION pooler, e.g. Supabase port 6543 with
# ?pgbouncer=true&connection_limit=1). Locally both can be the same URL.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true&connection_limit=1&schema=smis&sslmode=require"
# Direct / session connection used by `prisma migrate` and backups (Supabase session pooler port 5432)
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?schema=smis&sslmode=require"
# Initial administrator password used by the seed on first deploy (must be changed at first sign-in)
SEED_ADMIN_PASSWORD=""
# Public URL of the app (used for links in password-reset emails)
APP_URL="https://smis.bishopogez.com"

# ---- File storage ----
# "local" (development only: writes to ./storage) or "s3" (any S3-compatible store: AWS S3, Cloudflare R2, Backblaze B2)
STORAGE_DRIVER="local"
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# ---- Email (password resets, notices) ----
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Bishop Ogez High School <ogezhigh@gmail.com>"

# ---- SMS (Africa's Talking) ----
AT_USERNAME=""
AT_API_KEY=""
AT_SENDER_ID=""

# ---- WhatsApp Business (Meta Cloud API) ----
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
