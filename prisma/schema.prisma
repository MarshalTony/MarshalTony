// Bishop Ogez High School — School Management Information System
// PostgreSQL schema. Money is stored as Decimal(14,2) in UGX.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Direct (session) connection for migrations; on serverless hosts DATABASE_URL is a transaction pooler
  directUrl = env("DIRECT_URL")
}

// ============================================================================
// SETTINGS, IDENTITY & SECURITY
// ============================================================================

model SchoolSetting {
  id                  Int      @id @default(1)
  name                String
  motto               String?
  address             String?
  poBox               String?
  website             String?
  email               String?
  altEmail            String?
  phone               String?
  altPhone            String?
  logoFileId          String?
  centreNumberUce     String?
  centreNumberUace    String?
  reportFooter        String?
  headteacherName     String?
  /// Headteacher's signature image (private file, category SIGNATURE), printed on report cards and leaving documents
  headSignatureFileId String?
  /// Theme colour (#rrggbb) for the menu bar, buttons and links; null = the default blue
  themeColor          String?
  // Report-card template options (show/hide sections, signature labels...)
  reportTemplate      Json     @default("{}")
  // Notification switches (e.g. send SMS on payment)
  notificationPrefs   Json     @default("{}")
  updatedAt           DateTime @updatedAt
}

model User {
  id                 String    @id @default(cuid())
  username           String    @unique
  email              String?   @unique
  phone              String?
  fullName           String
  passwordHash       String
  isActive           Boolean   @default(true)
  mustChangePassword Boolean   @default(true)
  lastLoginAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  roles        UserRole[]
  sessions     Session[]
  loginHistory LoginHistory[]
  resetTokens  PasswordResetToken[]
  auditLogs    AuditLog[]
  staff        Staff?
  student      Student?
  guardian     Guardian?
}

model Role {
  id          String           @id @default(cuid())
  code        String           @unique
  name        String
  description String?
  isSystem    Boolean          @default(false)
  permissions RolePermission[]
  users       UserRole[]
}

model Permission {
  id          String           @id @default(cuid())
  code        String           @unique
  module      String
  description String
  roles       RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model Session {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  expiresAt  DateTime

  @@index([userId])
}

model LoginHistory {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  username  String
  success   Boolean
  reason    String?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([username, createdAt])
  @@index([ip, createdAt])
  @@index([userId, createdAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String?
  details   Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
  @@index([userId])
}

// Gap-free document numbering (receipts, invoices, vouchers...)
model Counter {
  key   String @id
  value Int    @default(0)
}

model StoredFile {
  id           String   @id @default(cuid())
  key          String   @unique
  originalName String
  mimeType     String
  size         Int
  // Who may read it: PUBLIC (logo), STUDENT_PHOTO, STAFF_PHOTO, DOCUMENT, MATERIAL
  category     String
  uploadedById String?
  // File contents when STORAGE_DRIVER=database (default on Vercel). Null for local/S3 storage.
  data         Bytes?
  createdAt    DateTime @default(now())
}

// Staged Excel imports: preview -> confirm. Rows are re-validated on commit.
model ImportBatch {
  id          String    @id @default(cuid())
  kind        String
  fileName    String
  context     Json      @default("{}")
  rows        Json
  errors      Json
  validCount  Int
  errorCount  Int
  status      String    @default("PREVIEW") // PREVIEW | COMMITTED | CANCELLED
  createdById String
  createdAt   DateTime  @default(now())
  committedAt DateTime?
}

// ============================================================================
// ACADEMIC STRUCTURE
// ============================================================================

enum Level {
  O_LEVEL
  A_LEVEL
}

model AcademicYear {
  id        String   @id @default(cuid())
  name      String   @unique
  startDate DateTime @db.Date
  endDate   DateTime @db.Date
  isCurrent Boolean  @default(false)

  terms              Term[]
  enrollments        Enrollment[]
  teacherAllocations TeacherAllocation[]
  studentSubjects    StudentSubject[]
  budgets            Budget[]
}

model Term {
  id             String       @id @default(cuid())
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  number         Int
  name           String
  startDate      DateTime     @db.Date
  endDate        DateTime     @db.Date
  nextTermStart  DateTime?    @db.Date
  isCurrent      Boolean      @default(false)

  exams             Exam[]
  feeStructures     FeeStructure[]
  activities        LearningActivity[]
  competencyRemarks CompetencyRemark[]
  invoices          Invoice[]
  payments          Payment[]
  ledger            LedgerEntry[]
  timetable         TimetableSlot[]
  transport         StudentTransport[]
  confirmations     StudentConfirmation[]

  @@unique([academicYearId, number])
}

model SchoolClass {
  id       String  @id @default(cuid())
  code     String  @unique
  name     String
  level    Level
  order    Int
  isActive Boolean @default(true)

  streams       Stream[]
  subjectRules  ClassSubject[]
  students      Student[]
  enrollments   Enrollment[]
  examSubjects  ExamSubject[]
  examClasses   ExamClass[]
  feeStructures FeeStructure[]
  materials     LearningMaterial[]
  activities    LearningActivity[]
}

model Stream {
  id                  String               @id @default(cuid())
  classId             String
  schoolClass         SchoolClass          @relation(fields: [classId], references: [id], onDelete: Restrict)
  name                String
  capacity            Int?
  classTeacherId      String?
  classTeacher        Staff?               @relation("ClassTeacher", fields: [classTeacherId], references: [id], onDelete: SetNull)
  isActive            Boolean              @default(true)
  /// A-Level: which combinations this stream holds (students are placed here by their combination's category)
  combinationCategory CombinationCategory?

  students           Student[]
  enrollments        Enrollment[]
  teacherAllocations TeacherAllocation[]
  markSubmissions    MarkSubmission[]
  timetable          TimetableSlot[]
  attendance         StudentAttendance[]
  assignments        Assignment[]

  @@unique([classId, name])
}

enum SubjectCategory {
  COMPULSORY
  ELECTIVE
  PRINCIPAL
  SUBSIDIARY
}

model Subject {
  id           String          @id @default(cuid())
  code         String          @unique
  name         String
  shortName    String?
  level        Level
  category     SubjectCategory
  // Weight used in A-Level points / weighted averages (configurable)
  weight       Decimal         @default(1) @db.Decimal(5, 2)
  hasPractical Boolean         @default(false)
  isActive     Boolean         @default(true)
  // Position on report cards and broadsheets (lower first; equal → alphabetical). Set in Classes & Subjects → Report order.
  reportOrder  Int             @default(100)
  // Number of examination papers (A-Level principals: 2 → P/1, P/2; General Paper / Sub-Maths: 1 → S/1). Marks are entered per paper.
  paperCount   Int             @default(1)
  departmentId String?
  department   Department?     @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  combinations       CombinationSubject[]
  classRules         ClassSubject[]
  teacherAllocations TeacherAllocation[]
  studentSubjects    StudentSubject[]
  examSubjects       ExamSubject[]
  marks              Mark[]
  subjectResults     SubjectResult[]
  markSubmissions    MarkSubmission[]
  timetable          TimetableSlot[]
  unebEntries        UnebSubjectEntry[]
  assignments        Assignment[]
  materials          LearningMaterial[]
  teachingStaff      StaffSubject[]
  activities         LearningActivity[]
  competencyRemarks  CompetencyRemark[]
}

model SubjectCombination {
  id       String               @id @default(cuid())
  code     String               @unique
  name     String
  /// Arts or Sciences: decides the student's stream (the S5/S6 stream with the same category)
  category CombinationCategory?
  isActive Boolean              @default(true)
  subjects CombinationSubject[]
  students Student[]
}

model CombinationSubject {
  combinationId String
  subjectId     String
  combination   SubjectCombination @relation(fields: [combinationId], references: [id], onDelete: Cascade)
  subject       Subject            @relation(fields: [subjectId], references: [id], onDelete: Restrict)

  @@id([combinationId, subjectId])
}

model TeacherAllocation {
  id             String       @id @default(cuid())
  staffId        String
  staff          Staff        @relation(fields: [staffId], references: [id], onDelete: Restrict)
  subjectId      String
  subject        Subject      @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  streamId       String
  stream         Stream       @relation(fields: [streamId], references: [id], onDelete: Restrict)
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Restrict)

  @@unique([staffId, subjectId, streamId, academicYearId])
  @@index([streamId, subjectId])
}

model StudentSubject {
  id             String       @id @default(cuid())
  studentId      String
  student        Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subjectId      String
  subject        Subject      @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Restrict)

  @@unique([studentId, subjectId, academicYearId])
  @@index([subjectId, academicYearId])
}

model TimetableSlot {
  id        String   @id @default(cuid())
  termId    String
  term      Term     @relation(fields: [termId], references: [id], onDelete: Cascade)
  streamId  String
  stream    Stream   @relation(fields: [streamId], references: [id], onDelete: Cascade)
  dayOfWeek Int // 1 = Monday
  startTime String // "08:00"
  endTime   String
  subjectId String?
  subject   Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  staffId   String?
  staff     Staff?   @relation(fields: [staffId], references: [id], onDelete: SetNull)
  label     String? // e.g. "Break", "Lunch"
  room      String?

  @@unique([streamId, termId, dayOfWeek, startTime])
}

model CalendarEvent {
  id          String   @id @default(cuid())
  title       String
  description String?
  type        String // TERM | EXAM | HOLIDAY | MEETING | EVENT
  startDate   DateTime @db.Date
  endDate     DateTime @db.Date
  audience    String   @default("ALL") // ALL | STAFF | PARENTS | STUDENTS
  createdAt   DateTime @default(now())
}

// ============================================================================
// STUDENTS & GUARDIANS
// ============================================================================

enum Gender {
  MALE
  FEMALE
}

enum Residence {
  DAY
  BOARDING
}

enum StudentStatus {
  ACTIVE
  SUSPENDED
  WITHDRAWN
  TRANSFERRED
  GRADUATED
  EXPELLED
}

model Student {
  id                    String              @id @default(cuid())
  admissionNo           String              @unique
  firstName             String
  lastName              String
  otherNames            String?
  gender                Gender
  dateOfBirth           DateTime?           @db.Date
  photoFileId           String?
  admissionDate         DateTime            @db.Date
  classId               String
  schoolClass           SchoolClass         @relation(fields: [classId], references: [id], onDelete: Restrict)
  streamId              String
  stream                Stream              @relation(fields: [streamId], references: [id], onDelete: Restrict)
  residence             Residence           @default(DAY)
  combinationId         String?
  combination           SubjectCombination? @relation(fields: [combinationId], references: [id], onDelete: SetNull)
  houseId               String?
  house                 House?              @relation(fields: [houseId], references: [id], onDelete: SetNull)
  nationality           String?             @default("Ugandan")
  religion              String?
  homeAddress           String?
  previousSchool        String?
  medicalInfo           String?
  emergencyContactName  String?
  emergencyContactPhone String?
  unebIndexNo           String?
  linNumber             String? // Learner Identification Number
  schoolPayCode         String? // SchoolPay payment code, printed on report cards
  status                StudentStatus       @default(ACTIVE)
  exitDate              DateTime?           @db.Date
  exitReason            String?
  userId                String?             @unique
  user                  User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  guardians         StudentGuardian[]
  clearances        StudentClearance[]
  leavingRecord     LeavingRecord?
  enrollments       Enrollment[]
  subjects          StudentSubject[]
  marks             Mark[]
  examResults       ExamResult[]
  subjectResults    SubjectResult[]
  reportComments    ReportComment[]
  invoices          Invoice[]
  payments          Payment[]
  ledger            LedgerEntry[]
  adjustments       FeeAdjustment[]
  attendance        StudentAttendance[]
  loans             LibraryLoan[]
  incidents         DisciplineIncident[]
  counselling       CounsellingRecord[]
  medical           MedicalIncident[]
  transport         StudentTransport[]
  unebCandidates    UnebCandidate[]
  activityScores    ActivityScore[]
  competencyRemarks CompetencyRemark[]
  clubs             ClubMember[]
  confirmations     StudentConfirmation[]

  @@index([classId, streamId, status])
  @@index([lastName, firstName])
}

model Guardian {
  id         String            @id @default(cuid())
  fullName   String
  phone      String
  altPhone   String?
  email      String?
  occupation String?
  address    String?
  nationalId String?
  userId     String?           @unique
  user       User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt  DateTime          @default(now())
  students   StudentGuardian[]

  @@index([phone])
}

model StudentGuardian {
  studentId    String
  guardianId   String
  relationship String // Father, Mother, Guardian, Sponsor...
  isPrimary    Boolean  @default(false)
  student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  guardian     Guardian @relation(fields: [guardianId], references: [id], onDelete: Cascade)

  @@id([studentId, guardianId])
}

enum EnrollmentStatus {
  ACTIVE
  PROMOTED
  REPEATED
  COMPLETED
  WITHDRAWN
}

// One row per student per academic year: the historical class record.
model Enrollment {
  id             String           @id @default(cuid())
  studentId      String
  student        Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  academicYearId String
  academicYear   AcademicYear     @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  classId        String
  schoolClass    SchoolClass      @relation(fields: [classId], references: [id], onDelete: Restrict)
  streamId       String
  stream         Stream           @relation(fields: [streamId], references: [id], onDelete: Restrict)
  status         EnrollmentStatus @default(ACTIVE)
  createdAt      DateTime         @default(now())

  @@unique([studentId, academicYearId])
  @@index([academicYearId, classId, streamId])
}

// ============================================================================
// STAFF & HR
// ============================================================================

model Department {
  id       String    @id @default(cuid())
  name     String    @unique
  staff    Staff[]
  subjects Subject[]
}

model Staff {
  id             String      @id @default(cuid())
  staffNo        String      @unique
  firstName      String
  lastName       String
  otherNames     String?
  gender         Gender
  dateOfBirth    DateTime?   @db.Date
  phone          String?
  email          String?
  nationalId     String?
  address        String?
  photoFileId    String?
  departmentId   String?
  department     Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  designation    String // Teacher, Bursar, Driver...
  isTeaching     Boolean     @default(true)
  employmentType String      @default("PERMANENT") // PERMANENT | CONTRACT | PART_TIME | VOLUNTEER
  dateJoined     DateTime?   @db.Date
  status         String      @default("ACTIVE") // ACTIVE | ON_LEAVE | SUSPENDED | EXITED
  // Sensitive (visible only with hr.sensitive)
  basicSalary    Decimal?    @db.Decimal(14, 2)
  bankName       String?
  bankAccount    String?
  tinNumber      String?
  nssfNumber     String?
  registrationNo String? // Teacher registration (Ministry of Education)
  userId         String?     @unique
  user           User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  qualifications StaffQualification[]
  subjects       StaffSubject[]
  allocations    TeacherAllocation[]
  classTeacherOf Stream[]             @relation("ClassTeacher")
  timetable      TimetableSlot[]
  attendance     StaffAttendance[]
  leaves         LeaveRequest[]
  payroll        PayrollRecord[]
  advances       SalaryAdvance[]
  appraisals     StaffAppraisal[]
  libraryLoans   LibraryLoan[]
  patronOfHouses House[]              @relation("HousePatron")
  patronOfClubs  Club[]               @relation("ClubPatron")
  driverProfile  Driver?

  @@index([lastName, firstName])
}

model StaffSubject {
  staffId   String
  subjectId String
  staff     Staff   @relation(fields: [staffId], references: [id], onDelete: Cascade)
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@id([staffId, subjectId])
}

model StaffQualification {
  id          String  @id @default(cuid())
  staffId     String
  staff       Staff   @relation(fields: [staffId], references: [id], onDelete: Cascade)
  title       String
  institution String?
  year        Int?
}

model LeaveRequest {
  id           String    @id @default(cuid())
  staffId      String
  staff        Staff     @relation(fields: [staffId], references: [id], onDelete: Cascade)
  type         String // ANNUAL | SICK | MATERNITY | PATERNITY | COMPASSIONATE | STUDY | OTHER
  startDate    DateTime  @db.Date
  endDate      DateTime  @db.Date
  reason       String?
  status       String    @default("PENDING") // PENDING | APPROVED | REJECTED | CANCELLED
  decidedById  String?
  decidedAt    DateTime?
  decisionNote String?
  createdAt    DateTime  @default(now())
}

model PayrollRecord {
  id              String    @id @default(cuid())
  staffId         String
  staff           Staff     @relation(fields: [staffId], references: [id], onDelete: Restrict)
  year            Int
  month           Int
  basic           Decimal   @db.Decimal(14, 2)
  allowances      Decimal   @default(0) @db.Decimal(14, 2)
  paye            Decimal   @default(0) @db.Decimal(14, 2)
  nssf            Decimal   @default(0) @db.Decimal(14, 2)
  advanceRecovery Decimal   @default(0) @db.Decimal(14, 2)
  otherDeductions Decimal   @default(0) @db.Decimal(14, 2)
  net             Decimal   @db.Decimal(14, 2)
  status          String    @default("DRAFT") // DRAFT | APPROVED | PAID
  paidAt          DateTime?
  createdAt       DateTime  @default(now())

  @@unique([staffId, year, month])
}

model SalaryAdvance {
  id           String   @id @default(cuid())
  staffId      String
  staff        Staff    @relation(fields: [staffId], references: [id], onDelete: Restrict)
  amount       Decimal  @db.Decimal(14, 2)
  recovered    Decimal  @default(0) @db.Decimal(14, 2)
  date         DateTime @db.Date
  reason       String?
  status       String   @default("PENDING") // PENDING | APPROVED | REJECTED | RECOVERED
  approvedById String?
  createdAt    DateTime @default(now())
}

model StaffAppraisal {
  id           String   @id @default(cuid())
  staffId      String
  staff        Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  period       String
  score        Int
  strengths    String?
  improvements String?
  appraiserId  String?
  createdAt    DateTime @default(now())
}

// ============================================================================
// EXAMINATIONS & RESULTS
// ============================================================================

model GradingScale {
  id        String      @id @default(cuid())
  name      String      @unique
  level     Level
  // Which subject categories use this scale (e.g. A-Level SUBSIDIARY uses its own)
  appliesTo String      @default("ALL") // ALL | PRINCIPAL | SUBSIDIARY
  isDefault Boolean     @default(false)
  bands     GradeBand[]
}

model GradeBand {
  id          String       @id @default(cuid())
  scaleId     String
  scale       GradingScale @relation(fields: [scaleId], references: [id], onDelete: Cascade)
  grade       String
  minScore    Decimal      @db.Decimal(5, 2)
  maxScore    Decimal      @db.Decimal(5, 2)
  points      Decimal      @db.Decimal(5, 2)
  remark      String
  // Longer descriptor printed in the report-card grading key (competency-based curriculum)
  description String?
}

// Ranking & aggregation rules per level — configurable, never hard-coded.
model ResultRule {
  id                String @id @default(cuid())
  level             Level  @unique
  // AVERAGE | TOTAL | POINTS | AGGREGATE (lower is better)
  rankingBasis      String @default("AVERAGE")
  // For AGGREGATE: number of best subjects summed (e.g. best 8)
  bestOfSubjects    Int?
  // COMPETITION (1,1,3) | DENSE (1,1,2)
  tieMethod         String @default("COMPETITION")
  // ZERO: absent counts as 0; EXCLUDE: absent subject is left out of averages
  absentPolicy      String @default("EXCLUDE")
  // Students with fewer graded subjects than this are not ranked
  minSubjectsToRank Int    @default(1)
  // Divisions / classification bands [{label, min, max}] applied to aggregate or points
  divisions         Json   @default("[]")
  topClassCount     Int    @default(12)
  topStreamCount    Int    @default(3)
}

model ExamType {
  id       String  @id @default(cuid())
  code     String  @unique
  name     String
  order    Int     @default(0)
  isActive Boolean @default(true)
  exams    Exam[]
}

enum ExamStatus {
  DRAFT
  OPEN
  CLOSED
  PUBLISHED
}

model Exam {
  id                 String     @id @default(cuid())
  name               String
  examTypeId         String
  examType           ExamType   @relation(fields: [examTypeId], references: [id], onDelete: Restrict)
  termId             String
  term               Term       @relation(fields: [termId], references: [id], onDelete: Restrict)
  // COMPOSITE exams compute marks from weighted component exams (examination formula)
  isComposite        Boolean    @default(false)
  status             ExamStatus @default(DRAFT)
  startDate          DateTime?  @db.Date
  endDate            DateTime?  @db.Date
  resultsGeneratedAt DateTime?
  createdAt          DateTime   @default(now())

  classes        ExamClass[]
  subjects       ExamSubject[]
  marks          Mark[]
  submissions    MarkSubmission[]
  results        ExamResult[]
  subjectResults SubjectResult[]
  comments       ReportComment[]
  components     ExamComponent[]      @relation("CompositeExam")
  usedIn         ExamComponent[]      @relation("ComponentExam")
  timetable      ExamTimetableEntry[]
}

model ExamComponent {
  id              String  @id @default(cuid())
  compositeExamId String
  compositeExam   Exam    @relation("CompositeExam", fields: [compositeExamId], references: [id], onDelete: Cascade)
  componentExamId String
  componentExam   Exam    @relation("ComponentExam", fields: [componentExamId], references: [id], onDelete: Restrict)
  weight          Decimal @db.Decimal(6, 2)

  @@unique([compositeExamId, componentExamId])
}

model ExamClass {
  examId      String
  classId     String
  exam        Exam        @relation(fields: [examId], references: [id], onDelete: Cascade)
  schoolClass SchoolClass @relation(fields: [classId], references: [id], onDelete: Restrict)

  @@id([examId, classId])
}

model ExamSubject {
  id          String      @id @default(cuid())
  examId      String
  exam        Exam        @relation(fields: [examId], references: [id], onDelete: Cascade)
  classId     String
  schoolClass SchoolClass @relation(fields: [classId], references: [id], onDelete: Restrict)
  subjectId   String
  subject     Subject     @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  maxMarks    Decimal     @default(100) @db.Decimal(6, 2)
  examDate    DateTime?   @db.Date

  @@unique([examId, classId, subjectId])
}

model ExamTimetableEntry {
  id        String   @id @default(cuid())
  examId    String
  exam      Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  classId   String
  subjectId String
  paper     String?
  date      DateTime @db.Date
  startTime String
  endTime   String
  venue     String?
}

enum MarkStatus {
  PRESENT
  ABSENT
  EXEMPTED
}

model Mark {
  id          String     @id @default(cuid())
  examId      String
  exam        Exam       @relation(fields: [examId], references: [id], onDelete: Cascade)
  studentId   String
  student     Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subjectId   String
  subject     Subject    @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  // Paper number (1 for single-paper subjects; A-Level principals have papers 1 and 2)
  paper       Int        @default(1)
  score       Decimal?   @db.Decimal(6, 2)
  status      MarkStatus @default(PRESENT)
  enteredById String?
  updatedAt   DateTime   @updatedAt

  @@unique([examId, studentId, subjectId, paper])
  @@index([examId, subjectId])
}

enum SubmissionStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

model MarkSubmission {
  id            String           @id @default(cuid())
  examId        String
  exam          Exam             @relation(fields: [examId], references: [id], onDelete: Cascade)
  streamId      String
  stream        Stream           @relation(fields: [streamId], references: [id], onDelete: Restrict)
  subjectId     String
  subject       Subject          @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  status        SubmissionStatus @default(DRAFT)
  submittedById String?
  submittedAt   DateTime?
  reviewedById  String?
  reviewedAt    DateTime?
  reviewNote    String?

  @@unique([examId, streamId, subjectId])
}

// Computed results snapshot (regenerated on demand; kept for history).
model ExamResult {
  id             String   @id @default(cuid())
  examId         String
  exam           Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  studentId      String
  student        Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classId        String
  streamId       String
  subjectsCount  Int
  total          Decimal  @db.Decimal(10, 2)
  average        Decimal  @db.Decimal(6, 2)
  points         Decimal? @db.Decimal(6, 2)
  aggregate      Int?
  division       String?
  classPosition  Int?
  classSize      Int
  streamPosition Int?
  streamSize     Int
  computedAt     DateTime @default(now())

  @@unique([examId, studentId])
  @@index([examId, classId])
}

model SubjectResult {
  id              String   @id @default(cuid())
  examId          String
  exam            Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  studentId       String
  student         Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subjectId       String
  subject         Subject  @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  score           Decimal? @db.Decimal(6, 2)
  percentage      Decimal? @db.Decimal(6, 2)
  // PRESENT | ABSENT | EXEMPTED | MISSING
  status          String
  grade           String?
  points          Decimal? @db.Decimal(5, 2)
  remark          String?
  subjectPosition Int?
  subjectSize     Int

  @@unique([examId, studentId, subjectId])
  @@index([examId, subjectId])
}

model ReportComment {
  id                  String   @id @default(cuid())
  examId              String
  exam                Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  studentId           String
  student             Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classTeacherComment String?
  dosComment          String?
  headteacherComment  String?
  conduct             String?
  updatedAt           DateTime @updatedAt

  @@unique([examId, studentId])
}

// ============================================================================
// FEES (append-only ledger)
// ============================================================================

model FeeStructure {
  id          String             @id @default(cuid())
  termId      String
  term        Term               @relation(fields: [termId], references: [id], onDelete: Restrict)
  classId     String
  schoolClass SchoolClass        @relation(fields: [classId], references: [id], onDelete: Restrict)
  residence   Residence
  items       FeeStructureItem[]

  @@unique([termId, classId, residence])
}

model FeeStructureItem {
  id          String       @id @default(cuid())
  structureId String
  structure   FeeStructure @relation(fields: [structureId], references: [id], onDelete: Cascade)
  name        String
  amount      Decimal      @db.Decimal(14, 2)
  isOptional  Boolean      @default(false)
}

model PaymentMethod {
  id       String    @id @default(cuid())
  code     String    @unique
  name     String
  isActive Boolean   @default(true)
  payments Payment[]
}

model Invoice {
  id          String        @id @default(cuid())
  invoiceNo   String        @unique
  studentId   String
  student     Student       @relation(fields: [studentId], references: [id], onDelete: Restrict)
  termId      String
  term        Term          @relation(fields: [termId], references: [id], onDelete: Restrict)
  total       Decimal       @db.Decimal(14, 2)
  issuedAt    DateTime      @default(now())
  dueDate     DateTime?     @db.Date
  createdById String
  lines       InvoiceLine[]

  @@index([studentId, termId])
}

model InvoiceLine {
  id          String  @id @default(cuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  description String
  amount      Decimal @db.Decimal(14, 2)
}

model Payment {
  id             String           @id @default(cuid())
  receiptNo      String           @unique
  transactionRef String           @unique
  studentId      String
  student        Student          @relation(fields: [studentId], references: [id], onDelete: Restrict)
  termId         String
  term           Term             @relation(fields: [termId], references: [id], onDelete: Restrict)
  amount         Decimal          @db.Decimal(14, 2)
  methodId       String
  method         PaymentMethod    @relation(fields: [methodId], references: [id], onDelete: Restrict)
  externalRef    String? // bank slip / MoMo transaction id / cheque no.
  payerName      String?
  payerPhone     String?
  paidAt         DateTime
  notes          String?
  recordedById   String
  createdAt      DateTime         @default(now())
  reversal       PaymentReversal?

  @@index([paidAt])
  @@index([studentId])
}

model PaymentReversal {
  id           String   @id @default(cuid())
  paymentId    String   @unique
  payment      Payment  @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  reason       String
  reversedById String
  createdAt    DateTime @default(now())
}

enum AdjustmentType {
  DISCOUNT
  SCHOLARSHIP
  BURSARY
  WAIVER
  DEBIT_ADJUSTMENT
  CREDIT_ADJUSTMENT
  OPENING_BALANCE
}

model FeeAdjustment {
  id           String         @id @default(cuid())
  referenceNo  String         @unique
  studentId    String
  student      Student        @relation(fields: [studentId], references: [id], onDelete: Restrict)
  termId       String?
  type         AdjustmentType
  // Positive amount. Direction is implied by type (debit types increase balance).
  amount       Decimal        @db.Decimal(14, 2)
  reason       String
  approvedById String
  createdAt    DateTime       @default(now())
}

enum LedgerType {
  OPENING_BALANCE
  INVOICE
  PAYMENT
  PAYMENT_REVERSAL
  DISCOUNT
  SCHOLARSHIP
  BURSARY
  WAIVER
  DEBIT_ADJUSTMENT
  CREDIT_ADJUSTMENT
}

// Every student money movement. Balance = SUM(debit) - SUM(credit).
// Protected by DB triggers: rows can never be updated or deleted.
model LedgerEntry {
  id          String     @id @default(cuid())
  studentId   String
  student     Student    @relation(fields: [studentId], references: [id], onDelete: Restrict)
  termId      String?
  term        Term?      @relation(fields: [termId], references: [id], onDelete: Restrict)
  type        LedgerType
  debit       Decimal    @default(0) @db.Decimal(14, 2)
  credit      Decimal    @default(0) @db.Decimal(14, 2)
  reference   String
  description String
  sourceId    String?
  createdById String
  createdAt   DateTime   @default(now())

  @@index([studentId, createdAt])
  @@index([termId])
}

