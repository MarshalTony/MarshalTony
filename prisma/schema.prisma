// ============================================================================
// CONTINUOUS ASSESSMENT — Activities of Integration (competency-based curriculum)
// Teachers record, per term, the chapters/themes covered in a subject for a class,
// score each learner out of 3 per chapter, and write a competency remark.
// On the end-of-term report: average ÷ 3 × 20 = "Out of 20"; + EOT/80 = total out of 100.
// ============================================================================

model LearningActivity {
  id          String          @id @default(cuid())
  termId      String
  term        Term            @relation(fields: [termId], references: [id], onDelete: Restrict)
  classId     String
  schoolClass SchoolClass     @relation(fields: [classId], references: [id], onDelete: Restrict)
  subjectId   String
  subject     Subject         @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  title       String // chapter / theme, e.g. "Drama"
  order       Int             @default(1)
  createdById String
  createdAt   DateTime        @default(now())
  scores      ActivityScore[]

  @@index([termId, classId, subjectId])
}

model ActivityScore {
  id          String           @id @default(cuid())
  activityId  String
  activity    LearningActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  studentId   String
  student     Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  score       Decimal          @db.Decimal(3, 1) // 0.0 – 3.0
  enteredById String?
  updatedAt   DateTime         @updatedAt

  @@unique([activityId, studentId])
}

model CompetencyRemark {
  id          String   @id @default(cuid())
  termId      String
  term        Term     @relation(fields: [termId], references: [id], onDelete: Restrict)
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subjectId   String
  subject     Subject  @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  remark      String
  enteredById String?
  updatedAt   DateTime @updatedAt

  @@unique([termId, studentId, subjectId])
}

/// Leaving clearance: one sign-off per office (BURSAR, LIBRARY, STORES, DISCIPLINE, CLASS_TEACHER).
model StudentClearance {
  id          String   @id @default(cuid())
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  office      String
  clearedById String
  clearedAt   DateTime @default(now())
  note        String?

  @@unique([studentId, office])
}

/// Issued when a student leaves: basis of the leaving certificate / testimonial and transfer letter.
model LeavingRecord {
  id                String   @id @default(cuid())
  studentId         String   @unique
  student           Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  certificateNo     String   @unique
  leavingDate       DateTime @db.Date
  reason            String // COMPLETED | TRANSFERRED | WITHDRAWN | EXPELLED
  lastClass         String
  conduct           String
  remarks           String?
  destinationSchool String?
  issuedById        String
  issuedAt          DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

/// Comment bank for report cards: suggestions per role and score range ({name} = student's first name).
model CommentTemplate {
  id        String   @id @default(cuid())
  role      String // CLASS_TEACHER | HEADTEACHER | DOS
  minScore  Decimal  @db.Decimal(5, 2)
  maxScore  Decimal  @db.Decimal(5, 2)
  text      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([role, minScore])
}

// ---------------------------------------------------------------- Houses & clubs
/// School houses: each student belongs to at most one house.
model House {
  id        String    @id @default(cuid())
  name      String    @unique
  colour    String?
  patronId  String?
  patron    Staff?    @relation("HousePatron", fields: [patronId], references: [id], onDelete: SetNull)
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  students  Student[]
}

/// Clubs and societies: a student can be in several clubs.
model Club {
  id          String       @id @default(cuid())
  name        String       @unique
  description String?
  patronId    String?
  patron      Staff?       @relation("ClubPatron", fields: [patronId], references: [id], onDelete: SetNull)
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  members     ClubMember[]
}

model ClubMember {
  id        String   @id @default(cuid())
  clubId    String
  club      Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  role      String? // e.g. Chairperson, Secretary (blank = member)
  joinedAt  DateTime @default(now())

  @@unique([clubId, studentId])
  @@index([studentId])
}

/// A student confirmed as having reported for a term.
model StudentConfirmation {
  id            String   @id @default(cuid())
  studentId     String
  student       Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  termId        String
  term          Term     @relation(fields: [termId], references: [id], onDelete: Cascade)
  confirmedById String?
  confirmedAt   DateTime @default(now())
  note          String?

  @@unique([studentId, termId])
  @@index([termId])
}

// ---------------------------------------------------------------- Subjects per class
/// How an O-Level subject is taken in one class (e.g. Kiswahili compulsory in S1–S2, optional in S3–S4).
/// No row = the subject's own category (compulsory / elective) applies.
enum ClassSubjectStatus {
  COMPULSORY
  OPTIONAL
  NOT_OFFERED
}

model ClassSubject {
  id          String             @id @default(cuid())
  classId     String
  schoolClass SchoolClass        @relation(fields: [classId], references: [id], onDelete: Cascade)
  subjectId   String
  subject     Subject            @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  status      ClassSubjectStatus

  @@unique([classId, subjectId])
}

/// A-Level combination category (decides the stream).
enum CombinationCategory {
  ARTS
  SCIENCES
}
