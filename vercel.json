{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run vercel-build",
  "regions": ["fra1"],
  "functions": {
    "src/app/api/pdf/**/*": { "maxDuration": 60, "memory": 1024 },
    "src/app/api/reports/**/*": { "maxDuration": 60, "memory": 1024 },
    "src/app/api/backup/route.ts": { "maxDuration": 60, "memory": 1024 }
  }
}
